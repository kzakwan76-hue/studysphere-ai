# Copy this file to .env and replace the value. Never commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=60
# DATABASE_URL defaults to a SQLite file in the storage/ folder.
# PostgreSQL later: DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/studysphere

# AI provider: none (default, shows the best passages only), ollama (free, local) or anthropic (needs an API key)
LLM_PROVIDER=none
# OLLAMA_MODEL=llama3.2
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Answers are refused when fewer than this share of the question's key words appear in the best passage
# ANSWER_MIN_COVERAGE=0.5
# ASK_LIMIT_PER_HOUR=30