# Copy this file to .env and replace the value. Never commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=60
# DATABASE_URL defaults to a SQLite file in the storage/ folder.
# PostgreSQL later: DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/studysphere